<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuraTune">
        <activity
            android:name=".Activity.LoginActivity"
            android:exported="false"
            android:label="@string/title_activity_login" />
        <!-- Launcher (entry) activity: Splash -> opens Login then Main -->
        <activity
            android:name=".Activity.SlpashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- MainActivity: exported true so can be deep-linked if needed -->
        <activity
            android:name=".Activity.MainActivity"
            android:exported="true" /> <!-- PlayerActivity (internal) -->
        <activity
            android:name=".Activity.PlayerActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.MenuPlayerActivity"
            android:exported="true" />
    </application>

</manifest>